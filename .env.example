# Copy this file to .env for local testing. On Render, set these as
# environment variables in the dashboard instead.

# Required: your bot token from the Discord developer portal.
DISCORD_TOKEN=

# Optional: Groq API key for AI-assisted moderation (free, no card).
# Leave empty to use the built-in rule-based filters only.
GROQ_API_KEY=

# Optional: secret key for the dashboard API. Pick any long random string.
# Without it, the dashboard API stays disabled. On Render, set it as an
# environment variable and use the same value in the dashboard page.
DASHBOARD_KEY=

# Optional: local port for the health endpoint.
PORT=8000
