# Copy this file to .env for local testing. On Render, set these as
# environment variables in the dashboard instead.

# Required: your bot token from the Discord developer portal.
DISCORD_TOKEN=

# Optional: Groq API key for AI-assisted moderation (free, no card).
# Leave empty to use the built-in rule-based filters only.
GROQ_API_KEY=

# Optional: Discord OAuth for the dashboard ("Log in with Discord").
# From the Discord developer portal: open your application, go to General
# Information, and copy the Client ID and Client Secret. Also add this
# Redirect URL under OAuth2 -> Redirects:
#   https://lynxo-bot.onrender.com/api/oauth/callback
# Only the server owner (or user IDs on the /nuke exempt list) can log in.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Optional: where the dashboard page is hosted. Defaults to the GitHub
# Pages site. Only set this if you move the dashboard somewhere else.
DASHBOARD_URL=

# Optional: local port for the health endpoint.
PORT=8000
